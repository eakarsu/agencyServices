generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(MEMBER)
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  clients              Client[]
  projects             Project[]
  tasks                Task[]
  timeEntries          TimeEntry[]
  campaigns            Campaign[]
  candidates           Candidate[]
  leads                Lead[]
  invoices             Invoice[]
  communications       Communication[]
  approvalWorkflows    ApprovalWorkflow[]
  comments             Comment[]
  activities           Activity[]
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

// ==================== CLIENT MANAGEMENT ====================
model Client {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  website         String?
  address         String?
  industry        String?
  status          ClientStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])

  // Relations
  contracts       Contract[]
  billingInfo     BillingInfo?
  projects        Project[]
  communications  Communication[]
  invoices        Invoice[]
  campaigns       Campaign[]
  leads           Lead[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CHURNED
}

model Contract {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  value           Float
  status          ContractStatus @default(DRAFT)
  documentUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

model BillingInfo {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingAddress  String?
  paymentTerms    Int      @default(30)
  preferredMethod PaymentMethod @default(BANK_TRANSFER)
  taxId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CHECK
  PAYPAL
}

model Communication {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            CommunicationType
  subject         String
  content         String
  createdAt       DateTime @default(now())
}

enum CommunicationType {
  EMAIL
  PHONE
  MEETING
  NOTE
}

// ==================== PROJECT MANAGEMENT ====================
model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId       String
  manager         User     @relation(fields: [managerId], references: [id])
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tasks           Task[]
  milestones      Milestone[]
  teamMembers     TeamMember[]
  files           ProjectFile[]
  approvalWorkflows ApprovalWorkflow[]
  timeEntries     TimeEntry[]
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Task {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assigneeId      String?
  assignee        User?    @relation(fields: [assigneeId], references: [id])
  status          TaskStatus @default(TODO)
  priority        Priority @default(MEDIUM)
  dueDate         DateTime?
  estimatedHours  Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  comments        Comment[]
  timeEntries     TimeEntry[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Milestone {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  dueDate         DateTime
  completed       Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeamMember {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  role            String?
  createdAt       DateTime @default(now())

  @@unique([projectId, userId])
}

model TimeEntry {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  hours           Float
  description     String?
  date            DateTime
  billable        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectFile {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  url             String
  type            String
  size            Int
  uploadedAt      DateTime @default(now())
}

model ApprovalWorkflow {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          ApprovalStatus @default(PENDING)
  requestedById   String
  requestedBy     User     @relation(fields: [requestedById], references: [id])
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== CAMPAIGN MANAGEMENT ====================
model Campaign {
  id              String   @id @default(cuid())
  name            String
  description     String?
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId       String
  manager         User     @relation(fields: [managerId], references: [id])
  status          CampaignStatus @default(DRAFT)
  type            CampaignType
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  spent           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  channels        CampaignChannel[]
  metrics         CampaignMetric[]
  abTests         ABTest[]
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignType {
  EMAIL
  SOCIAL
  PPC
  CONTENT
  SEO
  MULTI_CHANNEL
}

model CampaignChannel {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel         ChannelType
  budget          Float?
  spent           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ChannelType {
  GOOGLE_ADS
  META_ADS
  LINKEDIN_ADS
  TWITTER_ADS
  EMAIL
  ORGANIC_SOCIAL
  SEO
}

model CampaignMetric {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date            DateTime
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Int      @default(0)
  spend           Float    @default(0)
  revenue         Float    @default(0)
  createdAt       DateTime @default(now())
}

model ABTest {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name            String
  variantA        String
  variantB        String
  status          ABTestStatus @default(RUNNING)
  winnerVariant   String?
  startDate       DateTime @default(now())
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ABTestStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

// ==================== CANDIDATE MANAGEMENT ====================
model Candidate {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  resumeUrl       String?
  resumeText      String?
  skills          String[]
  experience      Int?
  currentTitle    String?
  currentCompany  String?
  expectedSalary  Float?
  location        String?
  status          CandidateStatus @default(NEW)
  score           Float?
  source          String?
  notes           String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  applications    Application[]
  interviews      Interview[]
  offers          Offer[]
  placements      Placement[]
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEWING
  OFFERED
  PLACED
  REJECTED
  WITHDRAWN
}

model JobPosition {
  id              String   @id @default(cuid())
  title           String
  description     String?
  requirements    String[]
  skills          String[]
  location        String?
  salaryMin       Float?
  salaryMax       Float?
  type            JobType  @default(FULL_TIME)
  status          JobStatus @default(OPEN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  applications    Application[]
  placements      Placement[]
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

model Application {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobPosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(RECEIVED)
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([candidateId, jobId])
}

enum ApplicationStatus {
  RECEIVED
  REVIEWED
  SHORTLISTED
  REJECTED
}

model Interview {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  duration        Int      @default(60)
  type            InterviewType
  location        String?
  notes           String?
  feedback        String?
  rating          Int?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Offer {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  salary          Float
  startDate       DateTime
  expiresAt       DateTime
  status          OfferStatus @default(PENDING)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Placement {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobPosition @relation(fields: [jobId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  salary          Float
  fee             Float?
  status          PlacementStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

// ==================== LEAD MANAGEMENT ====================
model Lead {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  company         String?
  title           String?
  source          LeadSource
  status          LeadStatus @default(NEW)
  score           Int      @default(0)
  qualityScore    Int?
  notes           String?
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  convertedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  followUps       FollowUp[]
  distributions   LeadDistribution[]
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL_CAMPAIGN
  SOCIAL_MEDIA
  AD_CAMPAIGN
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

model FollowUp {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            FollowUpType
  scheduledAt     DateTime
  completedAt     DateTime?
  notes           String?
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  DEMO
}

model LeadDistribution {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo      String
  assignedAt      DateTime @default(now())
  reason          String?
}

model DistributionRule {
  id              String   @id @default(cuid())
  name            String
  criteria        Json
  assignTo        String
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== BILLING & REVENUE ====================
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  type            BillingType
  status          InvoiceStatus @default(DRAFT)
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  items           InvoiceItem[]
  payments        Payment[]
}

enum BillingType {
  RETAINER
  PROJECT
  TIME_BASED
  COMMISSION
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float
  unitPrice       Float
  amount          Float
  createdAt       DateTime @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Float
  method          PaymentMethod
  reference       String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Retainer {
  id              String   @id @default(cuid())
  clientId        String
  amount          Float
  frequency       RetainerFrequency
  startDate       DateTime
  endDate         DateTime?
  status          RetainerStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum RetainerFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum RetainerStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Commission {
  id              String   @id @default(cuid())
  type            String
  referenceId     String
  amount          Float
  percentage      Float
  status          CommissionStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

// ==================== ACTIVITY LOG ====================
model Activity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  action          String
  entityType      String
  entityId        String
  metadata        Json?
  createdAt       DateTime @default(now())
}

// ==================== AI CONTENT ====================
model AIContent {
  id              String   @id @default(cuid())
  type            AIContentType
  prompt          String
  content         String
  metadata        Json?
  createdAt       DateTime @default(now())
}

enum AIContentType {
  MARKETING_CONTENT
  EMAIL
  SOCIAL_POST
  SEO_CONTENT
  PROPOSAL
  REPORT
  INTERVIEW_QUESTIONS
}

// ==================== LOOKUP/CONFIGURATION ====================
model Lookup {
  id          String   @id @default(cuid())
  category    String   // e.g., "industry", "lead_source", "candidate_source"
  value       String   // The actual value stored in database
  label       String   // Display label for UI
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, value])
  @@index([category, active])
}
